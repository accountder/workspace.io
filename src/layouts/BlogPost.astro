---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
				font-size: 1.05em;
				line-height: 1.8;
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1.5em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2.6em;
				letter-spacing: -0.02em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.title hr {
				max-width: 80px;
				margin: 1.5em auto 0;
				border-color: var(--accent);
				opacity: 0.3;
			}

			/* ── Prose: Headings ── */
			.prose :global(h2) {
				margin-top: 2.5em;
				margin-bottom: 0.6em;
				font-size: 1.75em;
				padding-bottom: 0.3em;
				border-bottom: 2px solid rgb(var(--gray-light));
			}
			.prose :global(h3) {
				margin-top: 2em;
				margin-bottom: 0.5em;
				font-size: 1.35em;
			}
			.prose :global(h4) {
				margin-top: 1.5em;
			}

			/* ── Prose: Paragraphs & Links ── */
			.prose :global(p) {
				margin-bottom: 1.2em;
			}
			.prose :global(a) {
				color: var(--accent);
				text-decoration: none;
				border-bottom: 1px solid transparent;
				transition: border-color 0.2s;
			}
			.prose :global(a:hover) {
				border-bottom-color: var(--accent);
			}

			/* ── Prose: Lists ── */
			.prose :global(ul),
			.prose :global(ol) {
				padding-left: 1.5em;
				margin-bottom: 1.2em;
			}
			.prose :global(li) {
				margin-bottom: 0.4em;
			}
			.prose :global(li > ul),
			.prose :global(li > ol) {
				margin-bottom: 0;
			}

			/* ── Prose: Tables ── */
			.prose :global(table) {
				width: 100%;
				border-collapse: separate;
				border-spacing: 0;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				overflow: hidden;
				margin: 1.5em 0;
				font-size: 0.93em;
			}
			.prose :global(th) {
				background: rgb(var(--gray-light));
				font-weight: 700;
				text-align: left;
				padding: 12px 16px;
				font-size: 0.9em;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.prose :global(td) {
				padding: 10px 16px;
				border-top: 1px solid rgb(var(--gray-light));
				vertical-align: top;
			}
			.prose :global(tbody tr:nth-child(even) td) {
				background: rgba(var(--gray-light), 0.35);
			}
			.prose :global(tbody tr:hover td) {
				background: rgba(var(--accent), 0.04);
			}

			/* ── Prose: Code ── */
			.prose :global(code) {
				background: rgba(var(--gray-light), 0.65);
				padding: 2px 8px;
				border-radius: 5px;
				font-size: 0.88em;
				font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
				color: #d63384;
			}
			.prose :global(pre) {
				position: relative;
				border-radius: 12px;
				border: 1px solid #1a1f2b;
				margin: 1.8em 0;
				padding: 0;
				overflow: hidden;
				font-size: 0.88em;
				line-height: 1.6;
			}
			.prose :global(pre > code) {
				all: unset;
				display: block;
				padding: 1.5em;
				overflow-x: auto;
				font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;
				font-size: 0.88em;
				line-height: 1.65;
				color: #e1e4e8;
			}
			/* Language label on code blocks */
			.prose :global(pre[data-language])::before {
				content: attr(data-language);
				display: block;
				padding: 6px 16px;
				font-size: 0.75em;
				font-family: var(--font-atkinson);
				font-weight: 600;
				color: rgba(255, 255, 255, 0.5);
				background: rgba(255, 255, 255, 0.06);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			/* ── Prose: Blockquote ── */
			.prose :global(blockquote) {
				margin: 1.8em 0;
				padding: 1em 1.5em;
				border-left: 4px solid var(--accent);
				background: rgba(var(--gray-light), 0.25);
				border-radius: 0 10px 10px 0;
				font-size: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose :global(blockquote p:last-child) {
				margin-bottom: 0;
			}

			/* ── Prose: Images ── */
			.prose :global(img) {
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				margin: 1.8em auto;
				display: block;
				max-width: 100%;
				height: auto;
			}

			/* ── Prose: HR ── */
			.prose :global(hr) {
				margin: 2.5em 0;
				border: none;
				border-top: 1px solid rgb(var(--gray-light));
			}

			/* ── Prose: Inline strong/em ── */
			.prose :global(strong) {
				color: rgb(var(--black));
			}

			/* ── Responsive ── */
			@media (max-width: 720px) {
				.title h1 {
					font-size: 1.8em;
				}
				.prose {
					font-size: 1em;
					padding: 0.5em;
				}
				.prose :global(h2) {
					font-size: 1.4em;
				}
				.prose :global(h3) {
					font-size: 1.15em;
				}
				.prose :global(table) {
					font-size: 0.85em;
				}
				.prose :global(th),
				.prose :global(td) {
					padding: 8px 10px;
				}
				.prose :global(pre) {
					font-size: 0.82em;
				}
				.prose :global(pre > code) {
					padding: 1em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" loading="lazy" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
