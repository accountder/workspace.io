---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCover from '../components/PostCover.astro';
import { categoryLabel, categoryStyle, readingTime, formatDate } from '../lib/site';

interface Props extends CollectionEntry<'blog'>['data'] {
	headings?: MarkdownHeading[];
	slug?: string;
}

const { title, description, pubDate, updatedDate, heroImage, category, headings = [], slug } =
	Astro.props;

const base = import.meta.env.BASE_URL;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 上下篇：按发布时间正序排列，找到当前篇的邻居
const asc = [...allPosts].reverse();
const index = asc.findIndex((p) => p.id === slug);
const prev = index > 0 ? asc[index - 1] : undefined;
const next = index >= 0 && index < asc.length - 1 ? asc[index + 1] : undefined;

const related = allPosts
	.filter((p) => p.id !== slug && p.data.category && p.data.category === category)
	.slice(0, 3);

const minutes = readingTime(asc[index]?.body);
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			publishedTime={pubDate}
			updatedTime={updatedDate}
		/>
	</head>
	<body>
		<Header />
		<div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

		<main class="article-page">
			<div class="article-grid">
				<article class="post">
					<header class="post-head">
						<nav class="crumbs" aria-label="面包屑">
							<a href={`${base}/blog`}>全部文章</a>
							<span aria-hidden="true">/</span>
							<span class="tag" style={categoryStyle(category)}>{categoryLabel(category)}</span>
						</nav>
						<h1>{title}</h1>
						{description && <p class="lede">{description}</p>}
						<p class="post-meta">
							<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
							<span class="dot" aria-hidden="true"></span>
							<span>{minutes} 分钟阅读</span>
							{
								updatedDate && (
									<>
										<span class="dot" aria-hidden="true" />
										<span>更新于 {formatDate(updatedDate)}</span>
									</>
								)
							}
						</p>
					</header>

					{
						heroImage && (
							<figure class="hero">
								<PostCover image={heroImage} title={title} category={category} variant="hero" priority />
							</figure>
						)
					}

					<div class="prose" id="content">
						<slot />
					</div>

					<footer class="post-foot">
						<a class="back-link" href={`${base}/blog`}>
							<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M13 8H3M7 4L3 8l4 4"></path>
							</svg>
							返回文章列表
						</a>
					</footer>

					<nav class="pager" aria-label="上下篇">
						{
							prev ? (
								<a class="pager-item" href={`${base}/blog/${prev.id}/`}>
									<span class="pager-label">← 上一篇</span>
									<span class="pager-title">{prev.data.title}</span>
								</a>
							) : (
								<span class="pager-item pager-item--empty"></span>
							)
						}
						{
							next ? (
								<a class="pager-item pager-item--next" href={`${base}/blog/${next.id}/`}>
									<span class="pager-label">下一篇 →</span>
									<span class="pager-title">{next.data.title}</span>
								</a>
							) : (
								<span class="pager-item pager-item--empty"></span>
							)
						}
					</nav>
				</article>

				{
					toc.length > 1 && (
						<aside class="toc" aria-label="目录">
							<p class="toc-title">目录</p>
							<nav>
								<ol>
									{toc.map((h) => (
										<li class:list={[{ 'is-sub': h.depth === 3 }]}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>
					)
				}
			</div>

			{
				related.length > 0 && (
					<section class="related">
						<div class="section-head">
							<h2>同类文章</h2>
						</div>
						<div class="related-grid">
							{related.map((post) => (
								<a class="related-card" href={`${base}/blog/${post.id}/`}>
									<span class="tag" style={categoryStyle(post.data.category)}>
										{categoryLabel(post.data.category)}
									</span>
									<h3>{post.data.title}</h3>
									<span class="related-meta">
										{formatDate(post.data.pubDate)} · {readingTime(post.body)} 分钟
									</span>
								</a>
							))}
						</div>
					</section>
				)
			}
		</main>

		<Footer />

		<button class="to-top" id="to-top" type="button" aria-label="回到顶部">
			<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M8 13V3M4 7l4-4 4 4"></path>
			</svg>
		</button>
	</body>
</html>

<script>
	// 阅读进度
	const bar = document.getElementById('progress-bar');
	function updateProgress() {
		const doc = document.documentElement;
		const max = doc.scrollHeight - doc.clientHeight;
		const ratio = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
		if (bar) bar.style.transform = `scaleX(${ratio})`;

		const toTop = document.getElementById('to-top');
		if (toTop) toTop.classList.toggle('is-visible', doc.scrollTop > 600);
	}
	document.addEventListener('scroll', updateProgress, { passive: true });
	updateProgress();

	// 回到顶部
	document.getElementById('to-top')?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

	// 代码块：复制按钮
	const content = document.getElementById('content');
	content?.querySelectorAll('pre').forEach((pre) => {
		const btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'copy-btn';
		btn.textContent = '复制';
		btn.setAttribute('aria-label', '复制代码');
		btn.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.textContent ?? '';
			try {
				await navigator.clipboard.writeText(code);
				btn.textContent = '已复制';
			} catch {
				btn.textContent = '复制失败';
			}
			setTimeout(() => (btn.textContent = '复制'), 1600);
		});
		pre.appendChild(btn);
	});

	// 表格：包一层横向滚动容器，避免窄屏撑破版心
	content?.querySelectorAll('table').forEach((table) => {
		if (table.parentElement?.classList.contains('table-wrap')) return;
		const wrap = document.createElement('div');
		wrap.className = 'table-wrap';
		table.parentNode?.insertBefore(wrap, table);
		wrap.appendChild(table);
	});

	// 目录高亮
	const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
	if (tocLinks.length) {
		const map = new Map(tocLinks.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const link = map.get(entry.target.id);
					if (!link) continue;
					tocLinks.forEach((a) => a.classList.remove('active'));
					link.classList.add('active');
				}
			},
			{ rootMargin: '-80px 0px -70% 0px', threshold: 0 },
		);
		map.forEach((_, id) => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});
	}
</script>

<style>
	.progress {
		position: fixed;
		top: var(--header-h);
		left: 0;
		right: 0;
		height: 2px;
		z-index: 40;
		pointer-events: none;
	}

	.progress span {
		display: block;
		height: 100%;
		width: 100%;
		transform: scaleX(0);
		transform-origin: 0 50%;
		background: linear-gradient(90deg, var(--accent), var(--accent-2));
		transition: transform 0.1s linear;
	}

	.article-page {
		width: 100%;
		max-width: calc(720px + 220px + 64px + var(--gutter) * 2);
		margin-inline: auto;
		padding: var(--space-6) var(--gutter) var(--space-8);
	}

	.article-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-7);
	}

	@media (min-width: 1080px) {
		.article-grid {
			grid-template-columns: minmax(0, 720px) 200px;
			justify-content: center;
		}
	}

	/* ── 头部 ── */
	.post-head {
		margin-bottom: var(--space-6);
	}

	.crumbs {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: var(--space-4);
		font-size: 13px;
		color: var(--text-muted);
	}

	.crumbs a {
		color: var(--text-muted);
		font-weight: 500;
	}

	.crumbs a:hover {
		color: var(--accent);
	}

	.post-head h1 {
		margin: 0 0 var(--space-3);
		font-size: clamp(1.7rem, 3.6vw, 2.5rem);
		line-height: 1.32;
		letter-spacing: -0.015em;
	}

	.lede {
		margin: 0 0 var(--space-4);
		font-size: 1.02rem;
		line-height: 1.85;
		color: var(--text-muted);
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		font-size: 13px;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}

	.hero {
		margin: 0 0 var(--space-6);
	}

	/* ── 正文 ── */
	.prose {
		font-size: 1.0625rem;
		line-height: 1.9;
		color: var(--text-secondary);
	}

	.prose > :global(*:first-child) {
		margin-top: 0;
	}

	.prose :global(h2) {
		margin: 2.4em 0 0.7em;
		padding-top: 0.2em;
		font-size: 1.45rem;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--text);
		scroll-margin-top: calc(var(--header-h) + 24px);
	}

	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(h3) {
		margin: 1.9em 0 0.6em;
		font-size: 1.15rem;
		color: var(--text);
		scroll-margin-top: calc(var(--header-h) + 24px);
	}

	.prose :global(h4) {
		margin: 1.6em 0 0.5em;
		font-size: 1.02rem;
		color: var(--text);
	}

	.prose :global(p) {
		margin: 0 0 1.35em;
	}

	.prose :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
		transition: text-decoration-color 0.18s ease;
	}

	.prose :global(a:hover) {
		text-decoration-color: currentColor;
	}

	.prose :global(strong) {
		font-weight: 700;
		color: var(--text);
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.35em;
		padding-left: 1.4em;
	}

	.prose :global(li) {
		margin-bottom: 0.45em;
	}

	.prose :global(li > ul),
	.prose :global(li > ol) {
		margin: 0.45em 0 0;
	}

	.prose :global(li::marker) {
		color: var(--text-muted);
	}

	.prose :global(hr) {
		margin: 2.6em 0;
		border: none;
		border-top: 1px solid var(--border);
	}

	/* 引用 */
	.prose :global(blockquote) {
		margin: 1.8em 0;
		padding: 1em 1.2em;
		border-left: 3px solid var(--accent);
		border-radius: 0 var(--radius) var(--radius) 0;
		background: var(--bg-inset);
		color: var(--text-secondary);
		font-size: 0.98em;
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	/* 行内代码 */
	.prose :global(code) {
		padding: 0.15em 0.4em;
		border-radius: var(--radius-xs);
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.86em;
		color: var(--text);
	}

	/* 代码块：亮暗两套 Shiki 主题 */
	.prose :global(pre) {
		position: relative;
		margin: 1.7em 0;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden !important;
		font-size: 0.875rem;
		line-height: 1.65;
	}

	.prose :global(pre > code) {
		display: block;
		padding: 1.15em 1.25em;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: inherit;
		background: none;
		border: none;
		color: inherit;
	}

	.prose :global(pre[data-language]) {
		padding-top: 30px;
	}

	.prose :global(pre[data-language])::before {
		content: attr(data-language);
		position: absolute;
		top: 0;
		left: 0;
		height: 30px;
		display: flex;
		align-items: center;
		padding: 0 14px;
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		border-bottom: 1px solid var(--border);
		border-right: 1px solid var(--border);
		border-radius: 0 0 8px 0;
		background: var(--bg-subtle);
	}

	html[data-theme='dark'] .prose :global(pre[data-language])::before {
		color: #9aa5b8;
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.07);
	}

	/* Astro + Shiki 双主题：按 data-theme 切换变量 */
	html[data-theme='dark'] :global(.astro-code),
	html[data-theme='dark'] :global(.astro-code span) {
		color: var(--shiki-dark) !important;
		background-color: var(--shiki-dark-bg) !important;
	}

	.prose :global(.copy-btn) {
		position: absolute;
		top: 4px;
		right: 6px;
		height: 22px;
		padding: 0 9px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--bg-card);
		color: var(--text-muted);
		font-size: 11px;
		font-weight: 600;
		cursor: pointer;
		opacity: 0.55;
		transition: opacity 0.18s ease, color 0.18s ease, background-color 0.18s ease;
	}

	.prose :global(pre:hover .copy-btn),
	.prose :global(.copy-btn:focus-visible) {
		opacity: 1;
	}

	@media (hover: none) {
		.prose :global(.copy-btn) {
			opacity: 1;
		}
	}

	.prose :global(.copy-btn:hover) {
		color: var(--accent);
	}

	/* 图片 */
	.prose :global(img) {
		display: block;
		margin: 1.8em auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}

	/* 表格 */
	.prose :global(.table-wrap) {
		margin: 1.7em 0;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		-webkit-overflow-scrolling: touch;
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.prose :global(thead th) {
		padding: 10px 14px;
		text-align: left;
		font-weight: 600;
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		color: var(--text-muted);
		background: var(--bg-subtle);
		border-bottom: 1px solid var(--border);
		white-space: nowrap;
	}

	.prose :global(td) {
		padding: 10px 14px;
		border-top: 1px solid var(--border);
		vertical-align: top;
	}

	.prose :global(tbody tr:first-child td) {
		border-top: none;
	}

	.prose :global(tbody tr:hover td) {
		background: var(--bg-inset);
	}

	/* 文中流程图（HTML 版） */
	.prose :global(.flow) {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 1.8em 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}

	.prose :global(.flow li) {
		position: relative;
		flex: 1 1 200px;
		margin: 0;
		padding: 14px 14px 14px 44px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-card);
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--text-secondary);
		counter-increment: step;
	}

	.prose :global(.flow li::before) {
		content: counter(step);
		position: absolute;
		left: 12px;
		top: 13px;
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: 11px;
		font-weight: 700;
	}

	.prose :global(.flow li strong) {
		display: block;
		margin-bottom: 2px;
		font-size: 0.9rem;
	}

	/* ── 尾部 ── */
	.post-foot {
		margin-top: var(--space-7);
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 600;
		color: var(--text-muted);
	}

	.back-link:hover {
		color: var(--accent);
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
		margin-top: var(--space-5);
	}

	.pager-item {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-card);
		color: inherit;
		transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}

	.pager-item:hover {
		border-color: var(--border-strong);
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
		color: inherit;
	}

	.pager-item--next {
		text-align: right;
		align-items: flex-end;
	}

	.pager-item--empty {
		visibility: hidden;
	}

	.pager-label {
		font-size: 12px;
		font-weight: 600;
		color: var(--text-muted);
	}

	.pager-title {
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--text);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── 目录 ── */
	.toc {
		display: none;
	}

	@media (min-width: 1080px) {
		.toc {
			display: block;
			position: sticky;
			top: calc(var(--header-h) + 32px);
			align-self: start;
			max-height: calc(100vh - var(--header-h) - 64px);
			overflow-y: auto;
			padding-left: var(--space-5);
			border-left: 1px solid var(--border);
		}
	}

	.toc-title {
		margin: 0 0 10px;
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc li {
		margin-bottom: 2px;
	}

	.toc li.is-sub {
		padding-left: 10px;
	}

	.toc a {
		display: block;
		padding: 4px 0;
		font-size: 13px;
		line-height: 1.5;
		color: var(--text-muted);
		border-left: 2px solid transparent;
		padding-left: 10px;
		margin-left: -11px;
		transition: color 0.18s ease, border-color 0.18s ease;
	}

	.toc a:hover,
	.toc a.active {
		color: var(--accent);
		border-left-color: var(--accent);
	}

	/* ── 相关 ── */
	.related {
		margin-top: var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px solid var(--border);
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
		gap: var(--space-4);
	}

