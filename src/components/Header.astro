---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={`${base}/`} aria-label={`${SITE_TITLE} 首页`}>
			<span class="brand-mark" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 19V9m5 10V5m5 14v-7m5 7V8"></path>
				</svg>
			</span>
			<span class="brand-text">{SITE_TITLE}</span>
		</a>

		<nav class="internal-links" aria-label="主导航">
			<HeaderLink href={`${base}/`}>首页</HeaderLink>
			<HeaderLink href={`${base}/blog`}>文章</HeaderLink>
			<HeaderLink href={`${base}/about`}>关于</HeaderLink>
		</nav>

		<div class="actions">
			<a
				class="icon-link"
				href="https://github.com/accountder"
				target="_blank"
				rel="noopener"
				title="GitHub"
			>
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="17" height="17" fill="currentColor">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-h);
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}

	@supports (backdrop-filter: blur(1px)) {
		.site-header {
			background: color-mix(in srgb, var(--bg) 82%, transparent);
			backdrop-filter: saturate(180%) blur(14px);
			-webkit-backdrop-filter: saturate(180%) blur(14px);
		}
	}

	.header-inner {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-4);
		height: 100%;
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		justify-self: start;
		color: var(--text);
		font-weight: 700;
		font-size: 15.5px;
		letter-spacing: 0.01em;
		padding: 6px 2px;
	}

	.brand:hover {
		color: var(--text);
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 8px;
		color: #fff;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		box-shadow: 0 2px 8px -2px var(--accent-ring);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 2px;
		justify-self: center;
	}

	.internal-links :global(a) {
		display: inline-flex;
		align-items: center;
		height: 34px;
		padding: 0 13px;
		border-radius: var(--radius-pill);
		font-size: 14px;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		transition: background-color 0.18s ease, color 0.18s ease;
	}

	.internal-links :global(a:hover) {
		background: var(--bg-subtle);
		color: var(--text);
	}

	.internal-links :global(a.active) {
		color: var(--accent);
		background: var(--accent-soft);
		font-weight: 600;
	}

	.actions {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 2px;
	}

	.icon-link {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		color: var(--text-muted);
		transition: background-color 0.18s ease, color 0.18s ease;
	}

	.icon-link:hover {
		background: var(--bg-subtle);
		color: var(--text);
	}

	@media (max-width: 720px) {
		.header-inner {
			grid-template-columns: auto 1fr auto;
			gap: var(--space-2);
		}
		.brand {
			font-size: 14.5px;
			gap: 7px;
		}
		.brand-mark {
			width: 23px;
			height: 23px;
			border-radius: 7px;
		}
		.internal-links {
			justify-self: end;
		}
		.internal-links :global(a) {
			height: 32px;
			padding: 0 9px;
			font-size: 13px;
		}
		.icon-link {
			display: none;
		}
	}

	@media (max-width: 400px) {
		.brand-text {
			display: none;
		}
	}
</style>
