---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image?: ImageMetadata;
	title: string;
	category?: string;
	variant?: 'card' | 'hero';
	priority?: boolean;
}

const { image, title, category = '综合', variant = 'card', priority = false } = Astro.props;

// 用标题生成稳定的伪随机柱状高度，让占位封面每次构建都一致
const seed = Array.from(title).reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) % 9973, 7);
const bars = Array.from({ length: 7 }, (_, i) => 26 + (((seed >> (i * 2)) % 11) * 5.5 + i * 3) % 62);
---

<div class:list={['cover', `cover--${variant}`, { 'cover--placeholder': !image }]}>
	{
		image ? (
			<Image
				src={image}
				alt={title}
				width={variant === 'hero' ? 1200 : 720}
				height={variant === 'hero' ? 600 : 405}
				widths={variant === 'hero' ? [720, 1200] : [360, 720]}
				sizes={variant === 'hero' ? '(max-width: 760px) 100vw, 720px' : '(max-width: 720px) 100vw, 520px'}
				loading={priority ? 'eager' : 'lazy'}
				fetchpriority={priority ? 'high' : 'auto'}
				decoding="async"
			/>
		) : (
			<div class="placeholder" aria-hidden="true">
				<svg viewBox="0 0 120 60" preserveAspectRatio="none">
					{bars.map((h, i) => (
						<rect x={8 + i * 15} y={54 - h} width="7" height={h} rx="2.5" />
					))}
				</svg>
				<span>{category}</span>
			</div>
		)
	}
</div>

<style>
	.cover {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: var(--bg-subtle);
		border-radius: var(--radius) var(--radius) 0 0;
	}

	.cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border-radius: 0;
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.cover--hero {
		aspect-ratio: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
		background: var(--bg-subtle);
	}

	.cover--hero :global(img) {
		height: auto;
		object-fit: contain;
		border-radius: var(--radius-lg);
		transition: none;
	}

	.cover--placeholder {
		background:
			radial-gradient(120% 120% at 15% 10%, var(--accent-soft), transparent 60%),
			linear-gradient(135deg, var(--bg-subtle), var(--bg-card));
	}

	.placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		color: var(--text-muted);
	}

	.placeholder svg {
		width: 45%;
		max-width: 190px;
		height: 42%;
		fill: currentColor;
		opacity: 0.16;
	}

	.placeholder span {
		font-size: 12.5px;
		font-weight: 600;
		letter-spacing: 0.14em;
		opacity: 0.7;
	}
</style>
