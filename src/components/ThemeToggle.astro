---
---

<button
	id="theme-toggle"
	class="theme-toggle"
	aria-label="切换亮暗主题"
	title="切换亮暗主题"
>
	<svg viewBox="0 0 16 16" fill="currentColor" width="18" height="18" class="theme-icon">
		<g class="sun-group">
			<circle cx="8" cy="8" r="3.4" />
			<path d="M8 0v2M8 14v2M0 8h2M14 8h2M2.34 2.34l1.42 1.42M12.24 12.24l1.42 1.42M2.34 13.66l1.42-1.42M12.24 3.76l1.42-1.42" stroke="currentColor" stroke-width="1.8" fill="none" />
		</g>
		<path d="M14 8A6 6 0 0 1 2 8a4 4 0 0 0 6 6 6 6 0 0 0 6-6z" class="moon-body" />
	</svg>
</button>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: none;
		border-radius: 8px;
		background: transparent;
		color: rgb(var(--gray));
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.theme-toggle:hover {
		background: rgb(var(--gray-light), 0.5);
		color: rgb(var(--black));
	}
	.theme-icon {
		transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	html[data-theme="dark"] .theme-icon {
		transform: rotate(180deg);
	}
	.sun-group { opacity: 1; }
	.moon-body { opacity: 0; }
	html[data-theme="dark"] .sun-group { opacity: 0; }
	html[data-theme="dark"] .moon-body { opacity: 1; }
	.theme-icon > g, .theme-icon > path {
		transition: opacity 0.3s ease;
	}
</style>

<script is:inline>
	const KEY = 'theme-preference';
	const html = document.documentElement;
	const btn = document.getElementById('theme-toggle');

	function setTheme(theme) {
		if (theme === 'dark') {
			html.setAttribute('data-theme', 'dark');
		} else {
			html.removeAttribute('data-theme');
		}
		try { localStorage.setItem(KEY, theme); } catch {}
	}

	const saved = (() => {
		try { return localStorage.getItem(KEY); } catch { return null; }
	})();
	if (saved) {
		setTheme(saved);
	} else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
		setTheme('dark');
	}

	btn?.addEventListener('click', () => {
		const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		setTheme(next);
	});
</script>
