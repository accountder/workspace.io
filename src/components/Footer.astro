---
import { SITE_TITLE } from '../consts';
const today = new Date();
const base = import.meta.env.BASE_URL;
---

<footer>
	<div class="footer-inner">
		<div class="footer-links">
			<a href={`${base}/`}>Home</a>
			<a href={`${base}/blog`}>Blog</a>
			<a href={`${base}/about`}>About</a>
			<a href={`${base}/rss.xml`}>RSS</a>
		</div>
		<div class="footer-copy">
			&copy; {today.getFullYear()} {SITE_TITLE}. All rights reserved.
		</div>
		<div class="footer-social">
			<a href="https://github.com/accountder" target="_blank" title="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20" fill="currentColor">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em 4em;
		background: var(--bg-page);
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-inner {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.2em;
	}
	.footer-links {
		display: flex;
		gap: 2em;
	}
	.footer-links a {
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.9em;
		transition: color 0.2s;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-copy {
		font-size: 0.85em;
		opacity: 0.7;
	}
	.footer-social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		color: rgb(var(--gray));
		transition: background 0.2s, color 0.2s;
	}
	.footer-social a:hover {
		background: rgb(var(--gray-light), 0.5);
		color: rgb(var(--black));
	}
</style>