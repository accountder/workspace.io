---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const today = new Date();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand">
				<span class="dot" aria-hidden="true"></span>
				<div>
					<p class="name">{SITE_TITLE}</p>
					<p class="tagline">{SITE_DESCRIPTION}</p>
				</div>
			</div>

			<nav class="footer-links" aria-label="页脚导航">
				<a href={`${base}/`}>首页</a>
				<a href={`${base}/blog`}>文章</a>
				<a href={`${base}/about`}>关于</a>
				<a href={`${base}/rss.xml`}>RSS</a>
				<a href="https://github.com/accountder" target="_blank" rel="noopener">GitHub</a>
			</nav>
		</div>

		<div class="footer-bottom">
			<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
			<p class="built">Built with Astro · 内容仅代表个人观点</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--bg);
		padding: var(--space-7) 0 var(--space-6);
	}

	.footer-inner {
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.footer-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-6);
		padding-bottom: var(--space-5);
		border-bottom: 1px solid var(--border);
	}

	.footer-brand {
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.dot {
		width: 8px;
		height: 8px;
		margin-top: 8px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		flex-shrink: 0;
	}

	.name {
		margin: 0 0 3px;
		font-size: 14.5px;
		font-weight: 700;
		color: var(--text);
	}

	.tagline {
		margin: 0;
		font-size: 13px;
		color: var(--text-muted);
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 18px;
	}

	.footer-links a {
		font-size: 13.5px;
		color: var(--text-muted);
		transition: color 0.18s ease;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
		padding-top: var(--space-4);
	}

	.footer-bottom p {
		margin: 0;
		font-size: 12.5px;
		color: var(--text-muted);
	}

	.built {
		opacity: 0.8;
	}

	@media (max-width: 720px) {
		.site-footer {
			padding-top: var(--space-6);
		}
		.footer-top {
			flex-direction: column;
			gap: var(--space-4);
		}
	}
</style>
