---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				padding: 2em 1em;
			}

			.page-header {
				text-align: center;
				margin-bottom: 3em;
			}
			.page-header h1 {
				font-size: 2.4em;
				margin: 0 0 0.2em;
				color: rgb(var(--black));
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin: 0;
			}

			.post-list {
				display: flex;
				flex-wrap: wrap;
				gap: 1.8rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				width: calc(50% - 0.9rem);
				background: white;
				border: 1px solid rgb(var(--gray-light), 0.6);
				border-radius: 16px;
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s;
				box-shadow: 0 2px 8px rgba(var(--gray), 5%);
			}
			.post-list li:hover {
				transform: translateY(-3px);
				box-shadow: 0 8px 24px rgba(var(--gray), 12%);
			}

			.post-list li:first-child {
				width: 100%;
				display: flex;
				flex-direction: row-reverse;
				align-items: center;
				gap: 2rem;
			}
			.post-list li:first-child .post-card-body {
				flex: 1;
				padding: 2rem;
			}
			.post-list li:first-child .post-card-body .title {
				font-size: 1.8em;
			}
			.post-list li:first-child img {
				width: 45%;
				min-height: 200px;
				object-fit: cover;
				border-radius: 0;
			}

			.post-list li a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.post-list li img {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				display: block;
			}
			.post-card-body {
				padding: 1.2em 1.4em 1.5em;
			}
			.post-card-body .title {
				margin: 0 0 0.4em;
				font-size: 1.15em;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.35;
				transition: color 0.2s;
			}
			.post-list li:hover .title {
				color: var(--accent);
			}
			.post-card-body .date {
				margin: 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.post-card-body .description {
				margin: 0.6em 0 0;
				font-size: 0.88em;
				color: rgb(var(--gray));
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 720px) {
				.post-list {
					gap: 1em;
				}
				.post-list li {
					width: 100%;
				}
				.post-list li:first-child {
					flex-direction: column;
					gap: 0;
				}
				.post-list li:first-child .post-card-body .title {
					font-size: 1.3em;
				}
				.post-list li:first-child img {
					width: 100%;
					min-height: auto;
					aspect-ratio: 2 / 1;
				}
				.post-list li:first-child .post-card-body {
					padding: 1.2em 1.4em 1.5em;
				}
				.page-header h1 {
					font-size: 1.8em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Blog</h1>
				<p>技术笔记与工作记录</p>
			</div>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`${base}/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div class="post-card-body">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										{post.data.description && (
											<p class="description">{post.data.description}</p>
										)}
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
