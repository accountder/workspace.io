---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostCover from '../../components/PostCover.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { categoryLabel, categoryStyle, readingTime, formatDate } from '../../lib/site';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 分类按文章数量排序，数量相同则按首次出现的顺序
const counts = new Map<string, number>();
for (const post of posts) {
	const key = categoryLabel(post.data.category);
	counts.set(key, (counts.get(key) ?? 0) + 1);
}
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`全部文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="blog-index">
			<header class="page-head">
				<p class="eyebrow">ARCHIVE</p>
				<h1>全部文章</h1>
				<p class="lead">共 {posts.length} 篇，涵盖财税自动化、财务分析与技术实践。</p>
			</header>

			<div class="filters" role="group" aria-label="按分类筛选">
				<button class="chip" data-filter="all" aria-pressed="true">
					全部<span class="count">{posts.length}</span>
				</button>
				{
					categories.map(([name, count]) => (
						<button class="chip" data-filter={name} aria-pressed="false">
							{name}
							<span class="count">{count}</span>
						</button>
					))
				}
			</div>

			<ul class="post-list">
				{
					posts.map((post, idx) => {
						const cat = categoryLabel(post.data.category);
						return (
							<li class="post-item" data-cat={cat} style={`--i:${Math.min(idx, 8)}`}>
								<a class="post-card" href={`${base}/blog/${post.id}/`}>
									<PostCover
										image={post.data.heroImage}
										title={post.data.title}
										category={cat}
									/>
									<div class="body">
										<div class="top">
											<span class="tag" style={categoryStyle(post.data.category)}>
												{cat}
											</span>
											<span class="meta">
												<time datetime={post.data.pubDate.toISOString()}>
													{formatDate(post.data.pubDate)}
												</time>
												<span class="dot"></span>
												<span>{readingTime(post.body)} 分钟</span>
											</span>
										</div>
										<h2>{post.data.title}</h2>
										<p class="desc">{post.data.description}</p>
										<span class="read-more">
											阅读全文
											<svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M3 8h10M9 4l4 4-4 4"></path>
											</svg>
										</span>
									</div>
								</a>
							</li>
						);
					})
				}
			</ul>

			<p class="empty" hidden>这个分类下还没有文章。</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const items = document.querySelectorAll<HTMLElement>('.post-item');
	const empty = document.querySelector<HTMLElement>('.empty');

	function apply(filter: string) {
		let visible = 0;
		items.forEach((item) => {
			const match = filter === 'all' || item.dataset.cat === filter;
			item.hidden = !match;
			if (match) visible += 1;
		});
		chips.forEach((chip) => {
			chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));
		});
		if (empty) empty.hidden = visible > 0;
	}

	chips.forEach((chip) => {
		chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all'));
	});
</script>

<style>
	.blog-index {
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: var(--space-7) var(--gutter) var(--space-8);
	}

	.page-head {
		margin-bottom: var(--space-6);
	}

	.page-head .eyebrow {
		margin: 0 0 10px;
		color: var(--text-muted);
		letter-spacing: 0.16em;
		font-size: 11.5px;
	}

	.page-head h1 {
		margin: 0 0 10px;
		font-size: clamp(2rem, 4vw, 2.6rem);
		letter-spacing: -0.02em;
	}

	.page-head .lead {
		margin: 0;
		color: var(--text-muted);
		font-size: 15px;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding-bottom: var(--space-5);
		margin-bottom: var(--space-5);
		border-bottom: 1px solid var(--border);
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		height: 34px;
		padding: 0 13px;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--bg-card);
		color: var(--text-secondary);
		font-size: 13.5px;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
	}

	.chip:hover {
		border-color: var(--border-strong);
		color: var(--text);
	}

	.chip[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.chip .count {
		font-size: 11.5px;
		font-variant-numeric: tabular-nums;
		opacity: 0.65;
	}

	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
		gap: var(--space-5);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-item[hidden] {
		display: none;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		color: inherit;
		animation: rise 0.4s ease-out both;
		animation-delay: calc(var(--i, 0) * 45ms);
		transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.post-card:hover {
		transform: translateY(-3px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
	}

	.post-card:hover :global(img) {
		transform: scale(1.04);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: var(--space-4) var(--space-5) var(--space-5);
		flex: 1;
	}

	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.meta {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 12.5px;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}

	.body h2 {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.5;
		letter-spacing: 0;
		color: var(--text);
		transition: color 0.18s ease;
	}

	.post-card:hover h2 {
		color: var(--accent);
	}

	.desc {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.7;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-top: auto;
		padding-top: 4px;
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.post-card:hover .read-more {
		opacity: 1;
		transform: translateX(0);
	}

	.empty {
		padding: var(--space-8) 0;
		text-align: center;
		color: var(--text-muted);
	}

	@media (max-width: 720px) {
		.blog-index {
			padding-top: var(--space-5);
		}
		.post-list {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}
		.read-more {
			opacity: 1;
			transform: none;
		}
		.top {
			align-items: flex-start;
			flex-direction: column;
			gap: 8px;
		}
	}
</style>
