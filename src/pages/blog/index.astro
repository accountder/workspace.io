---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 从文章路径推断分类标签
function getCategory(id: string): { label: string; color: string } {
	if (id.startsWith('tax-automa')) return { label: '财税自动化', color: '#1890ff' };
	if (id.startsWith('tax-economist')) return { label: '财务分析', color: '#52c41a' };
	if (id.startsWith('tax-plugin-guide')) return { label: '技术工具', color: '#722ed1' };
	return { label: '综合', color: '#8c8c8c' };
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* ── Page background ── */
			body {
				background: linear-gradient(135deg, #f8f9fb 0%, #eef1f5 100%);
				min-height: 100vh;
			}

			main {
				width: 960px;
				max-width: calc(100% - 2em);
				padding: 2.5em 1em 3em;
				margin: 0 auto;
			}

			/* ── Page header ── */
			.page-header {
				text-align: center;
				margin-bottom: 3.5em;
				position: relative;
			}
			.page-header h1 {
				font-size: 2.6em;
				margin: 0 0 0.15em;
				color: rgb(var(--black));
				letter-spacing: -0.02em;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin: 0 0 1.2em;
			}
			.page-header::after {
				content: '';
				display: block;
				width: 60px;
				height: 4px;
				background: linear-gradient(90deg, var(--accent), #5b6aff);
				border-radius: 4px;
				margin: 0 auto;
			}

			/* ── Post grid ── */
			.post-list {
				display: flex;
				flex-wrap: wrap;
				gap: 1.8rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			/* ── Individual card ── */
			.post-list li {
				width: calc(50% - 0.9rem);
				background: white;
				border: 1px solid rgb(var(--gray-light), 0.5);
				border-radius: 18px;
				overflow: hidden;
				transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
				            box-shadow 0.3s ease;
				box-shadow: 0 2px 10px rgba(var(--gray), 6%);
				animation: cardIn 0.45s ease-out both;
			}
			@keyframes cardIn {
				from { opacity: 0; transform: translateY(16px); }
				to   { opacity: 1; transform: translateY(0); }
			}
			.post-list li:nth-child(1) { animation-delay: 0.00s; }
			.post-list li:nth-child(2) { animation-delay: 0.08s; }
			.post-list li:nth-child(3) { animation-delay: 0.16s; }
			.post-list li:nth-child(4) { animation-delay: 0.24s; }
			.post-list li:nth-child(5) { animation-delay: 0.32s; }

			.post-list li:hover {
				transform: translateY(-5px);
				box-shadow: 0 12px 32px rgba(var(--gray), 14%);
			}

			/* ── Featured (first) card ── */
			.post-list li:first-child {
				width: 100%;
				display: flex;
				flex-direction: row-reverse;
				align-items: stretch;
				gap: 0;
			}
			.post-list li:first-child .post-card-body {
				flex: 1;
				padding: 2.2rem 2.4rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.post-list li:first-child .post-card-body .title {
				font-size: 1.15em;
				margin-bottom: 0.4em;
			}
			.post-list li:first-child .post-card-body .description {
				-webkit-line-clamp: 2;
			}
			.post-list li:first-child img {
				width: 48%;
				min-height: 220px;
				object-fit: cover;
				border-radius: 0;
			}

			/* ── Card image ── */
			.post-list li a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}
			.post-list li .img-wrap {
				overflow: hidden;
				line-height: 0;
			}
			.post-list li:not(:first-child) .img-wrap {
				border-radius: 18px 18px 0 0;
			}
			.post-list li img {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				display: block;
				transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
			}
			.post-list li:not(:first-child):hover img {
				transform: scale(1.06);
			}

			/* ── Card body ── */
			.post-card-body {
				padding: 1.3em 1.5em 1.6em;
			}
			.post-card-body .category-tag {
				display: inline-block;
				font-size: 0.72em;
				font-weight: 600;
				padding: 2px 10px;
				border-radius: 20px;
				margin-bottom: 0.6em;
				letter-spacing: 0.02em;
			}
			.post-card-body .title {
				margin: 0 0 0.35em;
				font-size: 1.15em;
				font-weight: 650;
				color: rgb(var(--black));
				line-height: 1.4;
				transition: color 0.2s;
			}
			.post-list li:hover .title {
				color: var(--accent);
			}
			.post-card-body .meta {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin: 0;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.post-card-body .meta .dot {
				display: inline-block;
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: rgb(var(--gray));
				opacity: 0.45;
			}
			.post-card-body .description {
				margin: 0.65em 0 0;
				font-size: 0.88em;
				color: rgb(var(--gray));
				line-height: 1.6;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* ── Responsive ── */
			@media (max-width: 820px) {
				.post-list {
					gap: 1.2em;
				}
				.post-list li {
					width: 100%;
				}
				.post-list li:first-child {
					flex-direction: column;
				}
				.post-list li:first-child .post-card-body .title {
					font-size: 1.15em;
				}
				.post-list li:first-child img {
					width: 100%;
					min-height: auto;
					aspect-ratio: 2 / 1;
				}
				.post-list li:first-child .post-card-body {
					padding: 1.3em 1.5em 1.6em;
				}
				.page-header h1 {
					font-size: 2em;
				}
			}

			@media (max-width: 480px) {
				main {
					padding: 1.5em 0.8em 2em;
				}
				.post-list {
					gap: 1em;
				}
				.post-card-body {
					padding: 1em 1.2em 1.3em;
				}
				.post-card-body .title {
					font-size: 1.05em;
				}
				.post-card-body .description {
					font-size: 0.84em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Blog</h1>
				<p>技术笔记与工作记录</p>
			</div>
			<section>
				<ul class="post-list">
					{
						posts.map((post) => {
							const cat = getCategory(post.id);
							return (
								<li>
									<a href={`${base}/blog/${post.id}/`}>
										{post.data.heroImage && (
											<div class="img-wrap">
												<Image width={720} height={360} src={post.data.heroImage} alt="" />
											</div>
										)}
										<div class="post-card-body">
											<span
												class="category-tag"
												style={`background: ${cat.color}18; color: ${cat.color}`}
											>
												{cat.label}
											</span>
											<h4 class="title">{post.data.title}</h4>
											<p class="meta">
												<FormattedDate date={post.data.pubDate} />
												<span class="dot"></span>
												<span>{cat.label}</span>
											</p>
											{post.data.description && (
												<p class="description">{post.data.description}</p>
											)}
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
