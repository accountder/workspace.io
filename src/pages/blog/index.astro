---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 分类颜色表（统一管理）
const categoryColors: Record<string, string> = {
	'财税自动化': '#1890ff',
	'财务分析': '#52c41a',
	'技术工具': '#722ed1',
	'生活记录': '#fa8c16',
};
const defaultColor = '#8c8c8c';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={'Blog | ' + SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* ── Page background ── */
			body {
				background: var(--bg-page);
				min-height: 100vh;
			}

			main {
				width: 100%;
				max-width: 1100px;
				padding: 2.5em 1em 3em;
				margin: 0 auto;
			}
			@media (max-width: 1140px) {
				main { width: calc(100% - 2em); }
			}
			@media (max-width: 720px) {
				main { width: calc(100% - 1.6em); padding: 2.5em 0.8em 3em; }
			}
			@media (max-width: 480px) {
				main { padding: 1.5em 0.4em 2em; }
			}

			/* ── Page header ── */
			.page-header {
				text-align: center;
				margin-bottom: 3.5em;
				position: relative;
			}
			.page-header h1 {
				font-size: 2.6em;
				margin: 0 0 0.15em;
				color: rgb(var(--black));
				letter-spacing: -0.02em;
			}
			.page-header p {
				color: rgb(var(--gray));
				font-size: 1.05em;
				margin: 0 0 1.2em;
			}
			.page-header::after {
				content: '';
				display: block;
				width: 60px;
				height: 4px;
				background: linear-gradient(90deg, var(--accent), #5b6aff);
				border-radius: 4px;
				margin: 0 auto;
			}

			/* ── Post grid (responsive) ── */
			.post-list {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
				gap: 1.8rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				background: var(--bg-card);
				border: 1px solid rgb(var(--gray-light), 0.5);
				border-radius: 18px;
				overflow: hidden;
				transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
				            box-shadow 0.3s ease;
				box-shadow: 0 2px 10px rgba(var(--gray), 6%);

				animation: cardIn 0.45s ease-out both;
				animation-delay: calc(var(--i, 0) * 0.08s);
			}
			@keyframes cardIn {
				from { opacity: 0; transform: translateY(16px); }
				to   { opacity: 1; transform: translateY(0); }
			}

			.post-list li:hover {
				transform: translateY(-5px);
				box-shadow: 0 12px 32px rgba(var(--gray), 14%);
			}

			.post-list li a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}

			.post-list li .img-wrap {
				overflow: hidden;
				line-height: 0;
				border-radius: 18px 18px 0 0;
			}
			.post-list li img {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				display: block;
				transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
			}
			.post-list li:hover img {
				transform: scale(1.06);
			}

			.post-card-body {
				padding: 1.3em 1.5em 1.6em;
			}
			.post-card-body .category-tag {
				display: inline-block;
				font-size: 0.72em;
				font-weight: 600;
				padding: 2px 10px;
				border-radius: 20px;
				margin-bottom: 0.6em;
				letter-spacing: 0.02em;
			}
			.post-card-body .title {
				margin: 0 0 0.35em;
				font-size: 1.15em;
				font-weight: 650;
				color: rgb(var(--black));
				line-height: 1.4;
				transition: color 0.2s;
			}
			.post-list li:hover .title {
				color: var(--accent);
			}
			.post-card-body .meta {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin: 0;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.post-card-body .meta .dot {
				display: inline-block;
				width: 3px;
				height: 3px;
				border-radius: 50%;
				background: rgb(var(--gray));
				opacity: 0.45;
			}
			.post-card-body .description {
				margin: 0.65em 0 0;
				font-size: 0.88em;
				color: rgb(var(--gray));
				line-height: 1.6;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 820px) {
				.post-list {
					grid-template-columns: 1fr;
					gap: 1.2rem;
				}
				.post-card-body .title {
					font-size: 1.15em;
				}
				.page-header h1 {
					font-size: 2em;
				}
			}

			@media (max-width: 480px) {
				.post-list {
					gap: 1em;
				}
				.post-card-body {
					padding: 1em 1.2em 1.3em;
				}
				.post-card-body .title {
					font-size: 1.05em;
				}
				.post-card-body .description {
					font-size: 0.84em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Blog</h1>
				<p>技术笔记与工作记录</p>
			</div>
			<section>
				<ul class="post-list">
					{
						posts.map((post, idx) => {
							const catLabel = post.data.category || '综合';
							const catColor = categoryColors[catLabel] || defaultColor;
							return (
									<li style={`--i: ${idx}`}>
									<a href={`${base}/blog/${post.id}/`}>
										{post.data.heroImage && (
											<div class="img-wrap">
												<Image width={720} height={360} src={post.data.heroImage} alt="" loading="lazy" />
											</div>
										)}
										<div class="post-card-body">
											<span
												class="category-tag"
												style={`background: ${catColor}18; color: ${catColor}`}
											>
												{catLabel}
											</span>
											<h4 class="title">{post.data.title}</h4>
											<p class="meta">
												<FormattedDate date={post.data.pubDate} />
												<span class="dot"></span>
												<span>{catLabel}</span>
											</p>
											{post.data.description && (
												<p class="description">{post.data.description}</p>
											)}
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

