---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<h1>财务 &amp; 税务 <span class="highlight">合规管理</span></h1>
				<p class="subtitle">
					聚焦建安制造 · 商贸批发 · 现代服务业
				</p>
			</section>

			<section class="profile-card">
				<div class="profile-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32">
						<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
					</svg>
				</div>
				<p class="bio">
					拥有<strong>3年</strong>财务会计与财税咨询经验，深耕建安制造、商贸批发及现代服务业领域的财税管理。精通增值税、企业所得税及高新技术企业财税政策体系，擅长依据行业经营特征定制<strong>差异化核算方案</strong>与<strong>税务风险管控策略</strong>。融合 AI 辅助编程、Chrome 扩展开发及 Power BI 等数字化工具提升财务运营效能，具备扎实的财税合规与资金统筹能力。累计处理<strong>10 余家</strong>企业的税务核查、稽查等风险应对事项。
				</p>
			</section>

			<section class="stats">
				<div class="stat-item">
					<span class="stat-number">3+</span>
					<span class="stat-label">年财税经验</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">10+</span>
					<span class="stat-label">税务风险案件</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">3</span>
					<span class="stat-label">核心行业</span>
				</div>
			</section>

			<section class="skills">
				<h2>专业能力</h2>
				<div class="skill-grid">
					<div class="skill-card">
						<div class="skill-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
								<path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
							</svg>
						</div>
						<h3>税务风控</h3>
						<p>增值税、企业所得税、高新企业政策合规</p>
					</div>
					<div class="skill-card">
						<div class="skill-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
								<path d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
							</svg>
						</div>
						<h3>数字化</h3>
						<p>AI 辅助开发 · Chrome 扩展 · 多语言编程</p>
					</div>
					<div class="skill-card">
						<div class="skill-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24">
								<path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
							</svg>
						</div>
						<h3>行业核算</h3>
						<p>建安制造 · 商贸批发 · 现代服务</p>
					</div>
				</div>
			</section>

			<section class="recent-posts">
				<h2>最新文章</h2>
				<ul class="post-list">
					{
						recentPosts.map((post) => (
							<li>
								<a href={`${base}/blog/${post.id}/`}>
									<span class="post-title">{post.data.title}</span>
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								</a>
							</li>
						))
					}
				</ul>
				<a href={`${base}/blog`} class="view-all">查看全部 &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.home {
		max-width: 800px;
		margin: 0 auto;
	}

	/* Hero */
	.hero {
		text-align: center;
		padding: 3em 0 2em;
	}
	.hero h1 {
		font-size: 2.8em;
		margin: 0 0 0.3em;
		letter-spacing: -0.02em;
	}
	.highlight {
		background: linear-gradient(135deg, var(--accent), #5b6aff);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.subtitle {
		font-size: 1.1em;
		color: rgb(var(--gray));
		letter-spacing: 0.08em;
		margin: 0;
	}

	/* Profile Card */
	.profile-card {
		background: var(--bg-card);
		border: 1px solid rgb(var(--gray-light), 0.6);
		border-radius: 16px;
		padding: 2em 2.5em;
		margin: 0 0 2em;
		box-shadow: 0 4px 20px rgba(var(--gray), 8%);
	}
	.profile-icon {
		display: flex;
		justify-content: center;
		margin-bottom: 1em;
		color: var(--accent);
	}
	.bio {
		font-size: 0.95em;
		line-height: 1.9;
		color: rgb(var(--gray-dark));
		margin: 0;
		text-align: justify;
	}
	.bio strong {
		color: rgb(var(--black));
	}

	/* Stats */
	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1em;
		margin-bottom: 2.5em;
	}
	.stat-item {
		background: var(--bg-card);
		border: 1px solid rgb(var(--gray-light), 0.5);
		border-radius: 12px;
		padding: 1.2em 0;
		text-align: center;
		box-shadow: 0 2px 8px rgba(var(--gray), 5%);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.stat-item:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(var(--gray), 12%);
	}
	.stat-number {
		display: block;
		font-size: 2em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1.2;
	}
	.stat-label {
		display: block;
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin-top: 0.3em;
	}

	/* Skills */
	.skills h2 {
		text-align: center;
		font-size: 1.6em;
		margin-bottom: 1.2em;
		color: rgb(var(--black));
	}
	.skill-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
		margin-bottom: 2em;
	}
	.skill-card {
		background: var(--bg-card);
		border: 1px solid rgb(var(--gray-light), 0.5);
		border-radius: 12px;
		padding: 1.8em 1.2em;
		text-align: center;
		box-shadow: 0 2px 8px rgba(var(--gray), 5%);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.skill-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 24px rgba(var(--gray), 12%);
	}
	.skill-icon {
		display: inline-flex;
		padding: 0.6em;
		background: rgba(var(--gray-light), 0.7);
		border-radius: 10px;
		color: var(--accent);
		margin-bottom: 0.8em;
	}
	.skill-card h3 {
		font-size: 1.1em;
		margin: 0 0 0.5em;
		color: rgb(var(--black));
	}
	.skill-card p {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 0;
		line-height: 1.5;
	}

	/* Recent Posts */
	.recent-posts {
		margin-top: 2em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.recent-posts h2 {
		text-align: center;
		font-size: 1.4em;
		margin-bottom: 1em;
		color: rgb(var(--black));
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1.2em;
	}
	.post-list li {
		padding: 0.8em 0;
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		text-decoration: none;
		color: inherit;
		gap: 1em;
		padding: 0.6em 1em;
		border-radius: 10px;
		transition: background 0.2s;
	}
	.post-list a:hover {
		background: rgb(var(--gray-light), 0.4);
	}
	.post-title {
		font-weight: 600;
		color: rgb(var(--black));
		transition: color 0.2s;
	}
	.post-list a:hover .post-title {
		color: var(--accent);
	}
	.post-date {
		font-size: 0.85em;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.view-all {
		display: block;
		text-align: center;
		font-size: 0.95em;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		padding: 0.5em;
	}
	.view-all:hover {
		text-decoration: underline;
	}

	@media (max-width: 640px) {
		.hero h1 {
			font-size: 2em;
		}
		.hero {
			padding: 2em 0 1.5em;
		}
		.profile-card {
			padding: 1.5em;
		}
		.stats {
			grid-template-columns: repeat(3, 1fr);
			gap: 0.6em;
		}
		.stat-number {
			font-size: 1.6em;
		}
		.skill-grid {
			grid-template-columns: 1fr;
			gap: 0.8em;
		}
	}
</style>

