---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCover from '../components/PostCover.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { categoryLabel, categoryStyle, readingTime, formatDate } from '../lib/site';

const base = import.meta.env.BASE_URL;
const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const skills = [
	{
		title: '税务风控',
		desc: '增值税、企业所得税与高新技术企业政策合规，覆盖核查与稽查应对。',
		path: 'M12 3l7 3v5.5c0 4.2-2.9 7.6-7 8.5-4.1-.9-7-4.3-7-8.5V6l7-3z',
	},
	{
		title: '数字化',
		desc: 'AI 辅助开发、Chrome 扩展与 Power BI，把重复劳动交给流程和脚本。',
		path: 'M4 5h16v10H4zM8 19h8M12 15v4',
	},
	{
		title: '行业核算',
		desc: '面向建安制造、商贸批发与现代服务业的差异化核算方案。',
		path: 'M4 20V9l5-4 5 4v11M9 20v-6h4v6M18 20V11l2-1.5',
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-glow" aria-hidden="true"></div>
				<p class="hero-eyebrow"><span class="pulse"></span>财税合规 · 技术实践 · 效率工具</p>
				<h1>财务 &amp; 税务 <span class="grad">合规管理</span></h1>
				<p class="hero-sub">
					聚焦建安制造、商贸批发与现代服务业，把合规要求拆成可执行、可复用的流程与工具。
				</p>
				<div class="hero-actions">
					<a class="btn btn--primary" href={`${base}/blog`}>
						阅读文章
						<svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M3 8h10M9 4l4 4-4 4"></path>
						</svg>
					</a>
					<a class="btn btn--ghost" href={`${base}/about`}>关于我</a>
				</div>

				<dl class="hero-stats">
					<div>
						<dt>财税经验</dt>
						<dd>3<span>年+</span></dd>
					</div>
					<div>
						<dt>风险应对</dt>
						<dd>10<span>+</span></dd>
					</div>
					<div>
						<dt>核心行业</dt>
						<dd>3<span>个</span></dd>
					</div>
				</dl>
			</section>

			<section class="brief card-surface">
				<div class="brief-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"></path>
						<path d="M4 20c0-2.7 3.6-4.5 8-4.5s8 1.8 8 4.5"></path>
					</svg>
				</div>
				<div class="brief-body">
					<h2>三年财税一线，做的是把"合规"落到账上</h2>
					<p>
						深耕建安制造、商贸批发及现代服务业，熟悉增值税、企业所得税与高新技术企业政策体系，擅长依据经营特征定制核算方案与风控策略。同时用 Automa、Chrome 扩展与 Power BI
						把重复工作流程化，让数据真正参与决策。
					</p>
				</div>
				<a class="brief-link" href={`${base}/about`}>
					了解更多
					<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M3 8h10M9 4l4 4-4 4"></path>
					</svg>
				</a>
			</section>

			<section class="skills">
				<div class="section-head">
					<h2>专业能力</h2>
				</div>
				<div class="skill-grid">
					{
						skills.map((s) => (
							<article class="skill card-surface">
								<span class="skill-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
										<path d={s.path} />
									</svg>
								</span>
								<h3>{s.title}</h3>
								<p>{s.desc}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="latest">
				<div class="section-head">
					<h2>最新文章</h2>
					<a class="more" href={`${base}/blog`}>查看全部 →</a>
				</div>
				<div class="post-grid">
					{
						recentPosts.map((post) => (
							<a class="post-card card-surface" href={`${base}/blog/${post.id}/`}>
								<PostCover
									image={post.data.heroImage}
									title={post.data.title}
									category={categoryLabel(post.data.category)}
								/>
								<div class="post-body">
									<span class="tag" style={categoryStyle(post.data.category)}>
										{categoryLabel(post.data.category)}
									</span>
									<h3>{post.data.title}</h3>
									<p class="post-desc">{post.data.description}</p>
									<p class="post-meta">
										<time datetime={post.data.pubDate.toISOString()}>
											{formatDate(post.data.pubDate)}
										</time>
										<span class="dot"></span>
										<span>{readingTime(post.body)} 分钟阅读</span>
									</p>
								</div>
							</a>
						))
					}
				</div>
			</section>

			<section class="subscribe card-surface">
				<div class="subscribe-text">
					<h2>订阅更新</h2>
					<p>新文章发布时会同步到 RSS，不需要邮箱，也不会有推送打扰。</p>
				</div>
				<div class="subscribe-actions">
					<a class="btn btn--primary" href={`${base}/rss.xml`}>
						<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
							<circle cx="6" cy="18" r="2.2"></circle>
							<path d="M4 10a10 10 0 0 1 10 10h-2.6A7.4 7.4 0 0 0 4 12.6z"></path>
							<path d="M4 4a16 16 0 0 1 16 16h-2.6A13.4 13.4 0 0 0 4 6.6z"></path>
						</svg>
						订阅 RSS
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 100%;
		max-width: var(--container-wide);
		margin-inline: auto;
		padding: var(--space-8) var(--gutter) var(--space-8);
	}

	/* ── Hero ── */
	.hero {
		position: relative;
		text-align: center;
		padding: var(--space-7) 0 var(--space-8);
	}

	.hero-glow {
		position: absolute;
		top: -140px;
		left: 50%;
		translate: -50% 0;
		width: min(760px, 90vw);
		height: 420px;
		pointer-events: none;
		background:
			radial-gradient(closest-side, var(--accent-soft), transparent 72%),
			radial-gradient(closest-side at 70% 40%, rgba(123, 92, 255, 0.1), transparent 70%);
		filter: blur(12px);
		z-index: -1;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 var(--space-5);
		padding: 6px 14px 6px 10px;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
		font-size: 12.5px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--text-secondary);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.hero h1 {
		margin: 0 0 var(--space-4);
		font-size: clamp(2.4rem, 6vw, 4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.grad {
		background: linear-gradient(115deg, var(--accent) 10%, var(--accent-2) 85%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}

	.hero-sub {
		max-width: 30em;
		margin: 0 auto var(--space-6);
		font-size: 1.02rem;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.hero-stats {
		display: flex;
		justify-content: center;
		gap: var(--space-7);
		margin: var(--space-7) 0 0;
		padding: 0;
		border-top: 1px solid var(--border);
		padding-top: var(--space-6);
	}

	.hero-stats div {
		display: flex;
		flex-direction: column-reverse;
		gap: 2px;
	}

	.hero-stats dt {
		font-size: 12.5px;
		color: var(--text-muted);
		letter-spacing: 0.04em;
	}

	.hero-stats dd {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 2px;
		margin: 0;
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.1;
		color: var(--text);
		font-variant-numeric: tabular-nums;
	}

	.hero-stats dd span {
		margin-left: 2px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-muted);
	}

	/* ── 简介 ── */
	.brief {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: start;
		gap: var(--space-5);
		padding: var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
		margin-bottom: var(--space-8);
	}

	.brief-icon {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 50%;
		color: var(--accent);
		background: var(--accent-soft);
	}

	.brief-body h2 {
		margin: 0 0 var(--space-2);
		font-size: 1.12rem;
		letter-spacing: 0;
	}

	.brief-body p {
		margin: 0;
		font-size: 15px;
		line-height: 1.85;
		color: var(--text-secondary);
	}

	.brief-link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 14px;
		font-weight: 600;
		white-space: nowrap;
		padding-top: 1px;
	}

	/* ── 能力 ── */
	.skills {
		margin-bottom: var(--space-8);
	}

	.skill-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-4);
	}

	.skill {
		position: relative;
		padding: var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
		transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
	}

	.skill:hover {
		transform: translateY(-2px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
	}

	.skill-icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin-bottom: var(--space-4);
		border-radius: var(--radius);
		color: var(--accent);
		background: var(--accent-soft);
	}

	.skill h3 {
		margin: 0 0 6px;
		font-size: 1rem;
		letter-spacing: 0;
	}

	.skill p {
		margin: 0;
		font-size: 14px;
		line-height: 1.75;
		color: var(--text-muted);
	}

	/* ── 文章 ── */
	.latest {
		margin-bottom: var(--space-8);
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-5);
	}

	.post-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition: transform 0.24s ease, box-shadow 0.24s ease, border-color 0.24s ease;
	}

	.post-card:hover {
		transform: translateY(-3px);
		border-color: var(--border-strong);
		box-shadow: var(--shadow);
	}

	.post-card:hover :global(img) {
		transform: scale(1.04);
	}

	.post-body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-5) var(--space-5);
		flex: 1;
	}

	.post-body h3 {
		margin: 0;
		font-size: 1rem;
		line-height: 1.5;
		letter-spacing: 0;
		color: var(--text);
		transition: color 0.18s ease;
	}

	.post-card:hover h3 {
		color: var(--accent);
	}

	.post-desc {
		margin: 0;
		font-size: 13.5px;
		line-height: 1.7;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: auto 0 0;
		padding-top: var(--space-2);
		font-size: 12.5px;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}

	/* ── 订阅 ── */
	.subscribe {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		padding: var(--space-6);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(120% 160% at 100% 0%, var(--accent-soft), transparent 55%),
			var(--bg-card);
	}

	.subscribe h2 {
		margin: 0 0 4px;
		font-size: 1.1rem;
		letter-spacing: 0;
	}

	.subscribe p {
		margin: 0;
		font-size: 14px;
		color: var(--text-muted);
	}

	@media (max-width: 980px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.home {
			padding-top: var(--space-5);
		}
		.hero {
			padding: var(--space-5) 0 var(--space-6);
		}
		.hero-stats {
			gap: var(--space-5);
		}
		.hero-stats dd {
			font-size: 1.45rem;
		}
		.brief {
			grid-template-columns: auto 1fr;
			padding: var(--space-5);
			gap: var(--space-4);
		}
		.brief-link {
			grid-column: 2;
		}
		.skill-grid {
			grid-template-columns: 1fr;
		}
		.post-grid {
			grid-template-columns: 1fr;
		}
		.subscribe {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
