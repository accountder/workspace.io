---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`页面未找到 | ${SITE_TITLE}`} description="您访问的页面不存在" noindex />
	</head>
	<body>
		<Header />
		<main class="not-found">
			<p class="code">404</p>
			<h1>页面未找到</h1>
			<p class="lead">这个地址可能已经被移除，或者链接拼错了。</p>
			<div class="actions">
				<a class="btn btn--primary" href={`${base}/`}>返回首页</a>
				<a class="btn btn--ghost" href={`${base}/blog`}>浏览文章</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		min-height: calc(100vh - var(--header-h) - 240px);
		padding: var(--space-8) var(--gutter);
	}

	.code {
		margin: 0;
		font-size: clamp(4.5rem, 16vw, 8rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}

	.not-found h1 {
		margin: var(--space-4) 0 var(--space-2);
		font-size: clamp(1.4rem, 3vw, 1.8rem);
	}

	.lead {
		margin: 0 0 var(--space-6);
		color: var(--text-muted);
	}

	.actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
		justify-content: center;
	}
</style>
